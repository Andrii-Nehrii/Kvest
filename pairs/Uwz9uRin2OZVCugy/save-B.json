A61":{"id":"it-A61","type":"phone","qty":1,"condition":100,"charge":31,"at":{"kind":"char","id":"A"},"changedAt":390},"it-A62":{"id":"it-A62","type":"keys_home","qty":1,"condition":100,"at":{"kind":"char","id":"A"},"changedAt":390},"it-B1":{"id":"it-B1","type":"phone","qty":1,"condition":100,"charge":58.82,"at":{"kind":"char","id":"B"},"changedAt":451},"it-B2":{"id":"it-B2","type":"keys_home","qty":1,"condition":100,"at":{"kind":"char","id":"B"},"changedAt":390}},"knowledge":{"A":{},"B":{"f_sirens":{"kind":"fact","at":390,"source":"b_wake"},"f_alert":{"kind":"fact","at":393,"source":"b_wake"},"f_schools_closed":{"kind":"fact","at":449,"source":"ev_schools"}}},"firedEvents":{"ev_schools@B":449,"ev_okafor_home":449},"messages":[],"log":[{"seq":1,"pid":"A","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":1,"pid":"B","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":2,"pid":"B","at":390,"kind":"action","text":"Выглянуть на улицу"},{"seq":3,"pid":"B","at":390,"kind":"news","text":"Ночью сирены почти не замолкали."},{"seq":4,"pid":"B","at":390,"kind":"story","text":"Внизу по мокрому асфальту медленно проезжает полицейская машина — без сирены, но с мигалкой, будто патрульные что-то высматривают. У киоска на углу уже трое с пакетами; кто-то тащит упаковку воды."},{"seq":5,"pid":"B","at":393,"kind":"action","text":"Прочитать ночное уведомление"},{"seq":6,"pid":"B","at":393,"kind":"news","text":"В 03:52 пришло экстренное оповещение: «опасная обстановка» в Гамбурге и окрестностях, оставаться в помещении, «избегать контакта с …» — дальше текст оборван."},{"seq":7,"pid":"B","at":393,"kind":"story","text":"«Gefahrenlage in Hamburg und Umgebung. Bleiben Sie in geschlossenen Räumen. Vermeiden Sie Kontakt mit …» — на этом текст обрывается. Ни подписи ведомства, ни ссылки. Такое приходит впервые."},{"seq":8,"pid":"B","at":394,"kind":"action","text":"Открыть новости"},{"seq":9,"pid":"B","at":394,"kind":"story","text":"«Keine Verbindung». Полоска сети мигает и гаснет. Ещё попытка — то же самое."},{"seq":10,"pid":"B","at":400,"kind":"action","text":"Одеться"},{"seq":11,"pid":"B","at":400,"kind":"story","text":"Джинсы, худи, кроссовки. Волосы — в хвост."},{"seq":12,"pid":"B","at":404,"kind":"action","text":"Переждать час у себя"},{"seq":13,"pid":"B","at":404,"kind":"story","text":"Ты ждёшь. Минуты тянутся; прислушиваешься к каждому звуку."},{"seq":14,"pid":"B","at":449,"kind":"news","text":"Радио: школы Гамбурга сегодня закрыты, причины не называют."},{"seq":15,"pid":"B","at":449,"kind":"news","text":"На площадке тяжёлые шаги, звякают ключи — долго, мимо замка. Потом глухой удар, будто кто-то привалился к двери напротив."},{"seq":16,"pid":"B","at":449,"kind":"action","text":"Позвонить Андрею"},{"seq":17,"pid":"B","at":449,"kind":"story","text":"Гудок. Второй. Третий… «Der gewünschte Gesprächspartner ist zurzeit nicht erreichbar.»"},{"seq":18,"pid":"B","at":451,"kind":"action","text":"Позвонить Андрею"},{"seq":19,"pid":"B","at":451,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."}],"rng":{"A":0,"B":0},"idSeq":{"A":62,"B":2},"logSeq":{"A":1,"B":19},"history":[]},"outgoing":"KVEST1.zRZBNboMwEIXv4nWCCElTwbIkC5RGSKhkwc42DnWKB2rsVEnEFdpeplK76B3ojTpG_Vl53nx-8zy-EGZlXZKI-ILNw6s982l4TSaEN2AEGARMGDr1vRk2BVQShLvsBZ6Pjb1uFMobLBXlWD0WS85UaG5XbUJPRbBS92pzyHJdb3eFYXdpJhOIN8smzdHTUqkTF54_nUObSQjSYhfb6oSsE8IRNgdbqXrKYr5-OK-3IzG2JdGFAFXCnZS76OF1-Px6Rl5S8yOHN5SVgF_5jlJC90eHD2zAuMLofnFv0uLf3U-I0VSazsWUWh4lVCQKcFtRSj7-xQItQneWdrLBoEXvPKfWDTk0EnDikUSz_hs","last":{"steps":[{"id":"call","label":"Позвонить {partner.dat}","text":["Вызов срывается, не начавшись: «Netz besetzt»."],"minutes":2,"outcome":"busy"}],"scene":"b_wake"}}}