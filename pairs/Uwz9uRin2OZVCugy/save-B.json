":"B"},"changedAt":507}},"knowledge":{"A":{},"B":{"f_sirens":{"kind":"fact","at":390,"source":"b_wake"},"f_alert":{"kind":"fact","at":393,"source":"b_wake"},"f_schools_closed":{"kind":"fact","at":449,"source":"ev_schools"},"f_bridges_closed":{"kind":"fact","at":465,"source":"ev_bridges"},"f_hospital_attacks":{"kind":"fact","at":466,"source":"b_kitchen"},"f_trains_disrupted":{"kind":"fact","at":481,"source":"ev_city_trains"},"f_bike_flat":{"kind":"fact","at":491,"source":"b_kitchen"},"f_merle_insulin":{"kind":"fact","at":501,"source":"b_kitchen"},"f_merle_erezept":{"kind":"fact","at":503,"source":"b_kitchen"}}},"firedEvents":{"ev_schools@B":449,"ev_okafor_home":449,"ev_bridges@B":465,"ev_city_trains@B":481},"messages":[{"id":"msg-B4","from":"B","to":"A","at":524,"template":"ok","text":"Я в порядке. Тут странно, но держусь.","delivered":false},{"id":"msg-B5","from":"B","to":"A","at":526,"template":"where","text":"Где ты? Ответь, как сможешь.","delivered":false},{"id":"msg-B6","from":"B","to":"A","at":528,"template":"warn","text":"Здесь происходит что-то плохое. Будь очень осторожен.","delivered":false},{"id":"msg-B7","from":"B","to":"A","at":530,"template":"coming","text":"Я к тебе. Жди и не открывай чужим.","delivered":false},{"id":"msg-B8","from":"B","to":"A","at":570,"template":"stay","text":"Никуда не выходи, сиди дома. Я на связи.","delivered":false}],"log":[{"seq":1,"pid":"A","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":1,"pid":"B","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":2,"pid":"B","at":390,"kind":"action","text":"Выглянуть на улицу"},{"seq":3,"pid":"B","at":390,"kind":"news","text":"Ночью сирены почти не замолкали."},{"seq":4,"pid":"B","at":390,"kind":"story","text":"Внизу по мокрому асфальту медленно проезжает полицейская машина — без сирены, но с мигалкой, будто патрульные что-то высматривают. У киоска на углу уже трое с пакетами; кто-то тащит упаковку воды."},{"seq":5,"pid":"B","at":393,"kind":"action","text":"Прочитать ночное уведомление"},{"seq":6,"pid":"B","at":393,"kind":"news","text":"В 03:52 пришло экстренное оповещение: «опасная обстановка» в Гамбурге и окрестностях, оставаться в помещении, «избегать контакта с …» — дальше текст оборван."},{"seq":7,"pid":"B","at":393,"kind":"story","text":"«Gefahrenlage in Hamburg und Umgebung. Bleiben Sie in geschlossenen Räumen. Vermeiden Sie Kontakt mit …» — на этом текст обрывается. Ни подписи ведомства, ни ссылки. Такое приходит впервые."},{"seq":8,"pid":"B","at":394,"kind":"action","text":"Открыть новости"},{"seq":9,"pid":"B","at":394,"kind":"story","text":"«Keine Verbindung». Полоска сети мигает и гаснет. Ещё попытка — то же самое."},{"seq":10,"pid":"B","at":400,"kind":"action","text":"Одеться"},{"seq":11,"pid":"B","at":400,"kind":"story","text":"Джинсы, худи, кроссовки. Волосы — в хвост."},{"seq":12,"pid":"B","at":404,"kind":"action","text":"Переждать час у себя"},{"seq":13,"pid":"B","at":404,"kind":"story","text":"Ты ждёшь. Минуты тянутся; прислушиваешься к каждому звуку."},{"seq":14,"pid":"B","at":449,"kind":"news","text":"Радио: школы Гамбурга сегодня закрыты, причины не называют."},{"seq":15,"pid":"B","at":449,"kind":"news","text":"На площадке тяжёлые шаги, звякают ключи — долго, мимо замка. Потом глухой удар, будто кто-то привалился к двери напротив."},{"seq":16,"pid":"B","at":449,"kind":"action","text":"Позвонить Андрею"},{"seq":17,"pid":"B","at":449,"kind":"story","text":"Гудок. Второй. Третий… «Der gewünschte Gesprächspartner ist zurzeit nicht erreichbar.»"},{"seq":18,"pid":"B","at":451,"kind":"action","text":"Позвонить Андрею"},{"seq":19,"pid":"B","at":451,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":20,"pid":"B","at":453,"kind":"action","text":"Позвонить Андрею"},{"seq":21,"pid":"B","at":453,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":22,"pid":"B","at":455,"kind":"action","text":"Позвонить Андрею"},{"seq":23,"pid":"B","at":455,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":24,"pid":"B","at":457,"kind":"action","text":"Собрать рюкзак: вода, еда, пауэрбанк, зарядка"},{"seq":25,"pid":"B","at":457,"kind":"story","text":"Рюкзак для универа, вытряхнутый на кровать: тетради — прочь. Вода, хлебцы, шоколад, пластыри, зажигалка, свечи, пауэрбанк, зарядка. Легко — и как-то несерьёзно."},{"seq":26,"pid":"B","at":463,"kind":"action","text":"Взять карту и наличные"},{"seq":27,"pid":"B","at":463,"kind":"story","text":"Тридцать евро наличными и карта. В Гамбурге ток есть — карта пока работает."},{"seq":28,"pid":"B","at":464,"kind":"action","text":"Посмотреть в глазок"},{"seq":29,"pid":"B","at":465,"kind":"news","text":"Радио: «Polizeieinsatz auf der Veddel» — мосты через Эльбу в сторону центра закрыты, на A1 авария, тоннель на A7 закрыт."},{"seq":30,"pid":"B","at":465,"kind":"story","text":"— Глазок —"},{"seq":31,"pid":"B","at":465,"kind":"action","text":"Отойти от двери"},{"seq":32,"pid":"B","at":465,"kind":"story","text":"Когда ты снова заглядываешь в глазок через минуту, площадка пуста. Дверь напротив закрыта."},{"seq":33,"pid":"B","at":466,"kind":"story","text":"— Кухня —"},{"seq":34,"pid":"B","at":466,"kind":"action","text":"Сделать радио погромче и послушать"},{"seq":35,"pid":"B","at":466,"kind":"news","text":"Новости: ночью нападения в нескольких больницах Гамбурга. Полиция: признаков теракта нет, «ситуация под контролем»."},{"seq":36,"pid":"B","at":466,"kind":"story","text":"Диктор говорит ровно, как всегда: «нападения в нескольких клиниках», «полиция призывает сохранять спокойствие», «Сенат проведёт пресс-конференцию». Между новостями — музыка, как будто ничего не случилось."},{"seq":37,"pid":"B","at":481,"kind":"news","text":"Push HVV: «Massive Störungen auf S1, S3, S5 und U3 — Polizeieinsätze.»"},{"seq":38,"pid":"B","at":481,"kind":"action","text":"Расспросить, что она слышала"},{"seq":39,"pid":"B","at":481,"kind":"story","text":"— Сирены с полуночи. В чате пишут разное: что в UKE кто-то напал на врачей, что в Wilhelmsburg перекрыли улицу, что это наркотик какой-то. Мама звонила в шесть, сказала — сидеть дома. — Мерле крутит кружку. — Я хочу к ним, в Ahrensburg. Но не одна."},{"seq":40,"pid":"B","at":491,"kind":"action","text":"Обсудить, что делать сегодня"},{"seq":41,"pid":"B","at":491,"kind":"news","text":"У велосипеда спущено заднее колесо — нужен насос."},{"seq":42,"pid":"B","at":491,"kind":"story","text":"— Можно на S-Bahn до Poppenbüttel, а там автобус, — Мерле уже открывает карту. — Если поезда ходят. Или подождать, пока скажут что-то нормальное. Ты как думаешь? — Ты вспоминаешь про свой велосипед во дворе: у него вечно спущено заднее колесо."},{"seq":43,"pid":"B","at":501,"kind":"action","text":"Заглянуть в холодильник"},{"seq":44,"pid":"B","at":501,"kind":"news","text":"У Мерле диабет 1 типа. Инсулина примерно на 9 дней, ручки нужно держать в холоде."},{"seq":45,"pid":"B","at":501,"kind":"story","text":"Яйца, молоко, остатки пасты. В дверце — три инсулиновые ручки Мерле. «Это где-то на девять дней», — говорит она, заметив твой взгляд, и отворачивается к окну."},{"seq":46,"pid":"B","at":503,"kind":"action","text":"Спросить, можно ли достать ещё инсулина"},{"seq":47,"pid":"B","at":503,"kind":"news","text":"У Мерле электронный рецепт на инсулин — его можно выкупить по её страховой карточке."},{"seq":48,"pid":"B","at":503,"kind":"story","text":"— Рецепт выписан, электронный — он на карточке страховки. Я всё собиралась в аптеку и… — Мерле пожимает плечами. — Сегодня я туда не пойду. Там люди. Там все кашляют."},{"seq":49,"pid":"B","at":507,"kind":"action","text":"Взять у Мерле карточку страховки — сходить в аптеку самой"},{"seq":50,"pid":"B","at":507,"kind":"story","text":"Мерле долго роется в сумке и протягивает тебе зелёную карточку. — Ты правда сходишь? — Она не умеет говорить «спасибо» серьёзно и поэтому говорит: — С меня торт. Когда-нибудь."},{"seq":51,"pid":"B","at":509,"kind":"action","text":"Правило: chargePhoneWhenFreePower"},{"seq":52,"pid":"B","at":509,"kind":"action","text":"Сделать радио погромче и послушать"},{"seq":53,"pid":"B","at":509,"kind":"story","text":"Школы Гамбурга сегодня закрыты «из соображений предосторожности». Полиция просит держаться подальше от клиник в Eppendorf и Barmbek. Пробки на въездах в город — «как обычно, только хуже»."},{"seq":54,"pid":"B","at":524,"kind":"action","text":"Правило: chargePhoneWhenFreePower"},{"seq":55,"pid":"B","at":524,"kind":"action","text":"Написать Андрею: «Я в порядке»"},{"seq":56,"pid":"B","at":524,"kind":"message","text":"Отправлено: «Я в порядке. Тут странно, но держусь.»"},{"seq":57,"pid":"B","at":526,"kind":"action","text":"Написать Андрею: «Где ты?»"},{"seq":58,"pid":"B","at":526,"kind":"message","text":"Отправлено: «Где ты? Ответь, как сможешь.»"},{"seq":59,"pid":"B","at":528,"kind":"action","text":"Написать Андрею: «Будь осторожнее»"},{"seq":60,"pid":"B","at":528,"kind":"message","text":"Отправлено: «Здесь происходит что-то плохое. Будь очень осторожен.»"},{"seq":61,"pid":"B","at":530,"kind":"action","text":"Написать Андрею: «Еду к тебе»"},{"seq":62,"pid":"B","at":530,"kind":"message","text":"Отправлено: «Я к тебе. Жди и не открывай чужим.»"},{"seq":63,"pid":"B","at":532,"kind":"action","text":"Сделать радио погромче и послушать"},{"seq":64,"pid":"B","at":532,"kind":"story","text":"Срочное сообщение: «Polizeieinsatz auf der Veddel» — Elbbrücken закрыты в сторону центра. На A1 у Norderelbbrücke грузовик лёг поперёк полос, тоннель на A7 к северу закрыт после аварии. Всех, кто едет в Гамбург с юга, просят развернуться."},{"seq":65,"pid":"B","at":547,"kind":"action","text":"Набрать воды про запас: ванну, кастрюли, бутылки"},{"seq":66,"pid":"B","at":547,"kind":"story","text":"Ванна наполняется медленно. Кастрюли, чайник, пустые бутылки из-под лимонада, даже вазу Мерле — всё, что держит воду, ты ставишь в ряд на полу кухни. Если трубы замолчат, вам хватит на несколько дней."},{"seq":67,"pid":"B","at":567,"kind":"action","text":"Выйти в прихожую"},{"seq":68,"pid":"B","at":568,"kind":"story","text":"— Прихожая —"},{"seq":69,"pid":"B","at":568,"kind":"action","text":"Накинуть цепочку и подпереть дверь стулом"},{"seq":70,"pid":"B","at":568,"kind":"story","text":"Цепочка входит в паз с сухим щелчком. Ты подставляешь под ручку стул спинкой — как в кино. Неизвестно, поможет ли, но руки перестают дрожать."},{"seq":71,"pid":"B","at":570,"kind":"action","text":"Написать Андрею: «Сиди дома»"},{"seq":72,"pid":"B","at":570,"kind":"message","text":"Отправлено: «Никуда не выходи, сиди дома. Я на связи.»"},{"seq":73,"pid":"B","at":572,"kind":"action","text":"Выйти на лестницу"},{"seq":74,"pid":"B","at":573,"kind":"story","text":"— Лестница —"},{"seq":75,"pid":"B","at":573,"kind":"action","text":"Постучать к Окафору"},{"seq":76,"pid":"B","at":573,"kind":"story","text":"Тишина. Потом глухо, из глубины квартиры, — храп. Он спит после смены."},{"seq":77,"pid":"B","at":575,"kind":"action","text":"Спуститься к Новакам"},{"seq":78,"pid":"B","at":576,"kind":"story","text":"— Новаки —"}],"rng":{"A":0,"B":0},"idSeq":{"A":62,"B":8},"logSeq":{"A":1,"B":78},"history":[]},"outgoing":"KVEST1.zRZBNboMwEIXv4nWCCElTwbIkC5RGSKhkwc42DnWKB2rsVEnEFdpeplK76B3ojTpG_Vl53nx-8zy-EGZlXZKI-ILNw6s982l4TSaEN2AEGARMGDr1vRk2BVQShLvsBZ6Pjb1uFMobLBXlWD0WS85UaG5XbUJPRbBS92pzyHJdb3eFYXdpJhOIN8smzdHTUqkTF54_nUObSQjSYhfb6oSsE8IRNgdbqXrKYr5-OK-3IzG2JdGFAFXCnZS76OF1-Px6Rl5S8yOHN5SVgF_5jlJC90eHD2zAuMLofnFv0uLf3U-I0VSazsWUWh4lVCQKcFtRSj7-xQItQneWdrLBoEXvPKfWDTk0EnDikUSz_hs","last":{"steps":[{"id":"okafor_knock","label":"Постучать к Окафору","text":["Тишина. Потом глухо, из глубины квартиры, — храп. Он спит после смены."],"minutes":2},{"id":"nowak","label":"Спуститься к Новакам","text":[],"minutes":1}],"scene":"b_nowak"}}}