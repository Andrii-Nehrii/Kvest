ter_15","qty":1,"condition":100,"at":{"kind":"char","id":"A"},"changedAt":416}},"knowledge":{"A":{"f_alert":{"kind":"fact","at":390,"source":"a_wake"},"f_ambulance":{"kind":"fact","at":397,"source":"a_wake"},"f_power_out_a":{"kind":"fact","at":397,"source":"a_wake"},"f_gerd_fever":{"kind":"fact","at":412,"source":"a_door"},"f_gerd_wound":{"kind":"fact","at":447,"source":"a_brockmann"}},"B":{}},"firedEvents":{"ev_knock":411,"ev_schools@A":440,"ev_police7":461,"ev_bridges@A":465,"ev_police7_seen":466},"messages":[{"id":"msg-A64","from":"A","to":"B","at":461,"template":"where","text":"Где ты? Ответь, как сможешь.","delivered":false},{"id":"msg-A65","from":"A","to":"B","at":463,"template":"warn","text":"Здесь происходит что-то плохое. Будь очень осторожна.","delivered":false}],"log":[{"seq":1,"pid":"A","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":1,"pid":"B","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":2,"pid":"A","at":390,"kind":"action","text":"Прочитать ночное уведомление"},{"seq":3,"pid":"A","at":390,"kind":"news","text":"В 03:52 пришло экстренное оповещение: «опасная обстановка» в Гамбурге и окрестностях, оставаться в помещении, «избегать контакта с …» — дальше текст оборван."},{"seq":4,"pid":"A","at":390,"kind":"story","text":"«Gefahrenlage in Hamburg und Umgebung. Bleiben Sie in geschlossenen Räumen. Vermeiden Sie Kontakt mit …» — на этом текст обрывается. Ни подписи ведомства, ни ссылки. Такое приходит впервые."},{"seq":5,"pid":"A","at":391,"kind":"action","text":"Открыть новости"},{"seq":6,"pid":"A","at":391,"kind":"story","text":"«Keine Verbindung». Полоска сети мигает и гаснет. Ещё попытка — то же самое."},{"seq":7,"pid":"A","at":397,"kind":"action","text":"Выглянуть в окно"},{"seq":8,"pid":"A","at":397,"kind":"news","text":"У соседнего дома стоит скорая с распахнутыми дверями — и никого рядом."},{"seq":9,"pid":"A","at":397,"kind":"news","text":"В твоей части Buchholz нет тока с раннего утра."},{"seq":10,"pid":"A","at":397,"kind":"story","text":"Двор пуст. Твой Corsa стоит на месте, в каплях. У соседнего дома — скорая: двери распахнуты, мигалка выключена, в салоне горит тусклый свет. Вокруг никого. Пока ты смотришь, к ней так никто и не подходит."},{"seq":11,"pid":"A","at":400,"kind":"action","text":"Проверить кухню и запасы"},{"seq":12,"pid":"A","at":400,"kind":"story","text":"На кухне холодно. В холодильнике — остатки с выходных; без тока он продержится несколько часов. В шкафу макароны, консервы, хлебцы. В ящике у двери — фонарик, в ванной — аптечка. Из крана течёт вода — пока."},{"seq":13,"pid":"A","at":405,"kind":"action","text":"Одеться по погоде"},{"seq":14,"pid":"A","at":405,"kind":"story","text":"Джинсы, худи, тёплые носки, ботинки. В квартире уже заметно прохладнее, чем вечером."},{"seq":15,"pid":"A","at":409,"kind":"action","text":"Взять тёплое: зимнюю куртку, шапку, перчатки"},{"seq":16,"pid":"A","at":409,"kind":"story","text":"Зимняя куртка — плотная, тяжёлая, ещё пахнет прошлым январём."},{"seq":17,"pid":"A","at":411,"kind":"news","text":"В дверь стучат — часто, сбивчиво. Звонок без тока молчит. Женский голос: «Hallo? Sind Sie wach? Bitte…»"},{"seq":18,"pid":"A","at":411,"kind":"action","text":"Подойти к двери"},{"seq":19,"pid":"A","at":412,"kind":"story","text":"— Глазок —"},{"seq":20,"pid":"A","at":412,"kind":"action","text":"Спросить через дверь, что случилось"},{"seq":21,"pid":"A","at":412,"kind":"news","text":"У Герда Брокмана с вечера жар и путаная речь. Ильзе думает, что это грипп."},{"seq":22,"pid":"A","at":412,"kind":"story","text":"— Герд… у него жар с вечера, он бредит. Телефон не ловит, сто двенадцать всё время занято. Вы же на машине? Пожалуйста. Это пять минут до больницы."},{"seq":23,"pid":"A","at":415,"kind":"action","text":"Не открывать и отойти от двери"},{"seq":24,"pid":"A","at":415,"kind":"story","text":"Ты отступаешь в темноту прихожей. Ильзе стучит ещё раз, тише, — и уходит."},{"seq":25,"pid":"A","at":416,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":26,"pid":"A","at":416,"kind":"action","text":"Собрать рюкзак: вода, еда, фонарик, аптечка, пауэрбанк"},{"seq":27,"pid":"A","at":416,"kind":"story","text":"Рюкзак, с которым ты ездил в горы: бутылка воды, хлебцы, банка фасоли, шоколад. Фонарик, автомобильная аптечка, антисептик, батарейки. Пауэрбанк — заряжен меньше чем наполовину. Мультитул, зажигалка, зарядка. Выходит килограммов пять."},{"seq":28,"pid":"A","at":424,"kind":"action","text":"Взять ключи от машины, карту и наличные"},{"seq":29,"pid":"A","at":424,"kind":"story","text":"Ключи от Corsa, банковская карта, сорок пять евро в кошельке. Без тока карта — просто пластик, но пусть будет."},{"seq":30,"pid":"A","at":425,"kind":"action","text":"Набрать воды про запас: ванну, кастрюли, бутылки"},{"seq":31,"pid":"A","at":425,"kind":"story","text":"Ванна наполняется медленно, трубы гудят. Кастрюли, чайник, пустые бутылки из-под лимонада — всё, что держит воду, стоит теперь в ряд на кухонном полу."},{"seq":32,"pid":"A","at":445,"kind":"action","text":"Всё-таки спуститься к Брокманам"},{"seq":33,"pid":"A","at":447,"kind":"story","text":"— Квартира Брокманов —"},{"seq":34,"pid":"A","at":447,"kind":"action","text":"Осмотреть повязку на руке"},{"seq":35,"pid":"A","at":447,"kind":"news","text":"На предплечье у Герда повязка: позавчера в порту его укусил «какой-то пьяный»."},{"seq":36,"pid":"A","at":447,"kind":"story","text":"Ты осторожно отводишь край марли. Полукруг следов зубов, края вспухшие, кожа вокруг горячая и багровая. Герд дёргает рукой и что-то бормочет — не по-немецки, не по-русски, просто звуки."},{"seq":37,"pid":"A","at":451,"kind":"action","text":"Сказать, что вернёшься, и подняться к себе"},{"seq":38,"pid":"A","at":453,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":39,"pid":"A","at":453,"kind":"action","text":"Позвонить Ане"},{"seq":40,"pid":"A","at":453,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":41,"pid":"A","at":455,"kind":"action","text":"Позвонить Ане"},{"seq":42,"pid":"A","at":455,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":43,"pid":"A","at":457,"kind":"action","text":"Позвонить Ане"},{"seq":44,"pid":"A","at":457,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":45,"pid":"A","at":459,"kind":"action","text":"Выйти из квартиры"},{"seq":46,"pid":"A","at":461,"kind":"story","text":"— Подъезд —"},{"seq":47,"pid":"A","at":461,"kind":"action","text":"Написать Ане: «Где ты?»"},{"seq":48,"pid":"A","at":461,"kind":"message","text":"Отправлено: «Где ты? Ответь, как сможешь.»"},{"seq":49,"pid":"A","at":463,"kind":"action","text":"Написать Ане: «Будь осторожнее»"},{"seq":50,"pid":"A","at":463,"kind":"message","text":"Отправлено: «Здесь происходит что-то плохое. Будь очень осторожна.»"},{"seq":51,"pid":"A","at":465,"kind":"action","text":"Выйти во двор, к машинам"},{"seq":52,"pid":"A","at":466,"kind":"story","text":"— Двор —"},{"seq":53,"pid":"A","at":466,"kind":"action","text":"Подойти к скорой у седьмого дома"},{"seq":54,"pid":"A","at":466,"kind":"news","text":"Во двор влетает полицейский универсал, тормозит у седьмого дома. Двое в жилетах бегут в подъезд, на ходу расстёгивая кобуры."},{"seq":55,"pid":"A","at":468,"kind":"story","text":"— Скорая —"}],"rng":{"A":0,"B":0},"idSeq":{"A":65,"B":2},"logSeq":{"A":55,"B":1},"history":[]},"last":{"steps":[{"id":"ambulance","label":"Подойти к скорой у седьмого дома","text":["Во двор влетает полицейский универсал, тормозит у седьмого дома. Двое в жилетах бегут в подъезд, на ходу расстёгивая кобуры."],"minutes":2}],"scene":"a_ambulance"}}}