at":447,"source":"a_brockmann"},"f_dispatch":{"kind":"fact","at":468,"source":"a_ambulance"},"f_rumor_water":{"kind":"rumor","at":473,"source":"a_street"},"f_rumor_harburg":{"kind":"fact","at":516,"source":"a_deniz"},"f_fuel_a":{"kind":"fact","at":481,"source":"a_drive"},"f_gas_no_power":{"kind":"fact","at":495,"source":"a_gas"},"f_deniz_petrol":{"kind":"fact","at":495,"source":"a_gas"},"f_kerem":{"kind":"fact","at":516,"source":"a_deniz"}},"B":{}},"firedEvents":{"ev_knock":411,"ev_schools@A":440,"ev_police7":461,"ev_bridges@A":465,"ev_police7_seen":466,"ev_city_trains@A":480,"ev_barmbek_shooting@A":580},"messages":[{"id":"msg-A64","from":"A","to":"B","at":461,"template":"where","text":"Где ты? Ответь, как сможешь.","delivered":false},{"id":"msg-A65","from":"A","to":"B","at":463,"template":"warn","text":"Здесь происходит что-то плохое. Будь очень осторожна.","delivered":false}],"log":[{"seq":1,"pid":"A","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":1,"pid":"B","at":390,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":2,"pid":"A","at":390,"kind":"action","text":"Прочитать ночное уведомление"},{"seq":3,"pid":"A","at":390,"kind":"news","text":"В 03:52 пришло экстренное оповещение: «опасная обстановка» в Гамбурге и окрестностях, оставаться в помещении, «избегать контакта с …» — дальше текст оборван."},{"seq":4,"pid":"A","at":390,"kind":"story","text":"«Gefahrenlage in Hamburg und Umgebung. Bleiben Sie in geschlossenen Räumen. Vermeiden Sie Kontakt mit …» — на этом текст обрывается. Ни подписи ведомства, ни ссылки. Такое приходит впервые."},{"seq":5,"pid":"A","at":391,"kind":"action","text":"Открыть новости"},{"seq":6,"pid":"A","at":391,"kind":"story","text":"«Keine Verbindung». Полоска сети мигает и гаснет. Ещё попытка — то же самое."},{"seq":7,"pid":"A","at":397,"kind":"action","text":"Выглянуть в окно"},{"seq":8,"pid":"A","at":397,"kind":"news","text":"У соседнего дома стоит скорая с распахнутыми дверями — и никого рядом."},{"seq":9,"pid":"A","at":397,"kind":"news","text":"В твоей части Buchholz нет тока с раннего утра."},{"seq":10,"pid":"A","at":397,"kind":"story","text":"Двор пуст. Твой Corsa стоит на месте, в каплях. У соседнего дома — скорая: двери распахнуты, мигалка выключена, в салоне горит тусклый свет. Вокруг никого. Пока ты смотришь, к ней так никто и не подходит."},{"seq":11,"pid":"A","at":400,"kind":"action","text":"Проверить кухню и запасы"},{"seq":12,"pid":"A","at":400,"kind":"story","text":"На кухне холодно. В холодильнике — остатки с выходных; без тока он продержится несколько часов. В шкафу макароны, консервы, хлебцы. В ящике у двери — фонарик, в ванной — аптечка. Из крана течёт вода — пока."},{"seq":13,"pid":"A","at":405,"kind":"action","text":"Одеться по погоде"},{"seq":14,"pid":"A","at":405,"kind":"story","text":"Джинсы, худи, тёплые носки, ботинки. В квартире уже заметно прохладнее, чем вечером."},{"seq":15,"pid":"A","at":409,"kind":"action","text":"Взять тёплое: зимнюю куртку, шапку, перчатки"},{"seq":16,"pid":"A","at":409,"kind":"story","text":"Зимняя куртка — плотная, тяжёлая, ещё пахнет прошлым январём."},{"seq":17,"pid":"A","at":411,"kind":"news","text":"В дверь стучат — часто, сбивчиво. Звонок без тока молчит. Женский голос: «Hallo? Sind Sie wach? Bitte…»"},{"seq":18,"pid":"A","at":411,"kind":"action","text":"Подойти к двери"},{"seq":19,"pid":"A","at":412,"kind":"story","text":"— Глазок —"},{"seq":20,"pid":"A","at":412,"kind":"action","text":"Спросить через дверь, что случилось"},{"seq":21,"pid":"A","at":412,"kind":"news","text":"У Герда Брокмана с вечера жар и путаная речь. Ильзе думает, что это грипп."},{"seq":22,"pid":"A","at":412,"kind":"story","text":"— Герд… у него жар с вечера, он бредит. Телефон не ловит, сто двенадцать всё время занято. Вы же на машине? Пожалуйста. Это пять минут до больницы."},{"seq":23,"pid":"A","at":415,"kind":"action","text":"Не открывать и отойти от двери"},{"seq":24,"pid":"A","at":415,"kind":"story","text":"Ты отступаешь в темноту прихожей. Ильзе стучит ещё раз, тише, — и уходит."},{"seq":25,"pid":"A","at":416,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":26,"pid":"A","at":416,"kind":"action","text":"Собрать рюкзак: вода, еда, фонарик, аптечка, пауэрбанк"},{"seq":27,"pid":"A","at":416,"kind":"story","text":"Рюкзак, с которым ты ездил в горы: бутылка воды, хлебцы, банка фасоли, шоколад. Фонарик, автомобильная аптечка, антисептик, батарейки. Пауэрбанк — заряжен меньше чем наполовину. Мультитул, зажигалка, зарядка. Выходит килограммов пять."},{"seq":28,"pid":"A","at":424,"kind":"action","text":"Взять ключи от машины, карту и наличные"},{"seq":29,"pid":"A","at":424,"kind":"story","text":"Ключи от Corsa, банковская карта, сорок пять евро в кошельке. Без тока карта — просто пластик, но пусть будет."},{"seq":30,"pid":"A","at":425,"kind":"action","text":"Набрать воды про запас: ванну, кастрюли, бутылки"},{"seq":31,"pid":"A","at":425,"kind":"story","text":"Ванна наполняется медленно, трубы гудят. Кастрюли, чайник, пустые бутылки из-под лимонада — всё, что держит воду, стоит теперь в ряд на кухонном полу."},{"seq":32,"pid":"A","at":445,"kind":"action","text":"Всё-таки спуститься к Брокманам"},{"seq":33,"pid":"A","at":447,"kind":"story","text":"— Квартира Брокманов —"},{"seq":34,"pid":"A","at":447,"kind":"action","text":"Осмотреть повязку на руке"},{"seq":35,"pid":"A","at":447,"kind":"news","text":"На предплечье у Герда повязка: позавчера в порту его укусил «какой-то пьяный»."},{"seq":36,"pid":"A","at":447,"kind":"story","text":"Ты осторожно отводишь край марли. Полукруг следов зубов, края вспухшие, кожа вокруг горячая и багровая. Герд дёргает рукой и что-то бормочет — не по-немецки, не по-русски, просто звуки."},{"seq":37,"pid":"A","at":451,"kind":"action","text":"Сказать, что вернёшься, и подняться к себе"},{"seq":38,"pid":"A","at":453,"kind":"story","text":"— Вторник, 10 ноября —"},{"seq":39,"pid":"A","at":453,"kind":"action","text":"Позвонить Ане"},{"seq":40,"pid":"A","at":453,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":41,"pid":"A","at":455,"kind":"action","text":"Позвонить Ане"},{"seq":42,"pid":"A","at":455,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":43,"pid":"A","at":457,"kind":"action","text":"Позвонить Ане"},{"seq":44,"pid":"A","at":457,"kind":"story","text":"Вызов срывается, не начавшись: «Netz besetzt»."},{"seq":45,"pid":"A","at":459,"kind":"action","text":"Выйти из квартиры"},{"seq":46,"pid":"A","at":461,"kind":"story","text":"— Подъезд —"},{"seq":47,"pid":"A","at":461,"kind":"action","text":"Написать Ане: «Где ты?»"},{"seq":48,"pid":"A","at":461,"kind":"message","text":"Отправлено: «Где ты? Ответь, как сможешь.»"},{"seq":49,"pid":"A","at":463,"kind":"action","text":"Написать Ане: «Будь осторожнее»"},{"seq":50,"pid":"A","at":463,"kind":"message","text":"Отправлено: «Здесь происходит что-то плохое. Будь очень осторожна.»"},{"seq":51,"pid":"A","at":465,"kind":"action","text":"Выйти во двор, к машинам"},{"seq":52,"pid":"A","at":466,"kind":"story","text":"— Двор —"},{"seq":53,"pid":"A","at":466,"kind":"action","text":"Подойти к скорой у седьмого дома"},{"seq":54,"pid":"A","at":466,"kind":"news","text":"Во двор влетает полицейский универсал, тормозит у седьмого дома. Двое в жилетах бегут в подъезд, на ходу расстёгивая кобуры."},{"seq":55,"pid":"A","at":468,"kind":"story","text":"— Скорая —"},{"seq":56,"pid":"A","at":468,"kind":"action","text":"Послушать рацию"},{"seq":57,"pid":"A","at":468,"kind":"news","text":"По рации скорой диспетчер требовал от бригад «соблюдать самозащиту» — Eigenschutz."},{"seq":58,"pid":"A","at":468,"kind":"story","text":"Сквозь треск — женский голос диспетчера, быстрый, без интонаций: «…alle verfügbaren Kräfte… Buchholz-Nord… Eigenschutz beachten, ich wiederhole, Eigenschutz…» Потом длинный писк, и тишина."},{"seq":59,"pid":"A","at":471,"kind":"action","text":"Отойти к своему двору"},{"seq":60,"pid":"A","at":472,"kind":"story","text":"— Двор —"},{"seq":61,"pid":"A","at":472,"kind":"action","text":"Выйти на улицу"},{"seq":62,"pid":"A","at":473,"kind":"story","text":"— Улица —"},{"seq":63,"pid":"A","at":473,"kind":"action","text":"Поговорить с соседом в халате"},{"seq":64,"pid":"A","at":473,"kind":"news","text":"Сосед уверен, что вода из-под крана может быть отравлена."},{"seq":65,"pid":"A","at":473,"kind":"news","text":"Говорят, ночью в Harburg у Phoenix-центра стреляли."},{"seq":66,"pid":"A","at":473,"kind":"story","text":"— Сеть? Да какая сеть, — сосед машет телефоном. — Брат из Harburg написал в пять: ночью у них стреляли. А в Гамбурге, говорят, бешенство. Я из-под крана больше не пью — вдруг вода. — Он затягивается. — Ты тоже никуда не дозвонился?"},{"seq":67,"pid":"A","at":479,"kind":"action","text":"Пройти во двор"},{"seq":68,"pid":"A","at":480,"kind":"story","text":"— Двор —"},{"seq":69,"pid":"A","at":480,"kind":"action","text":"Сесть в машину"},{"seq":70,"pid":"A","at":481,"kind":"story","text":"— За рулём —"},{"seq":71,"pid":"A","at":481,"kind":"action","text":"Посмотреть, сколько бензина"},{"seq":72,"pid":"A","at":481,"kind":"news","text":"В баке Corsa около 14 литров — на пару сотен километров без пробок."},{"seq":73,"pid":"A","at":481,"kind":"story","text":"Стрелка — чуть выше четверти. Литров четырнадцать: пара сотен километров по трассе, если без пробок. На заправку ты собирался ещё в пятницу."},{"seq":74,"pid":"A","at":482,"kind":"action","text":"Поставить телефон заряжаться от прикуривателя"},{"seq":75,"pid":"A","at":482,"kind":"story","text":"Кабель еле дотягивается до гнезда. Значок молнии на экране — маленькая победа."},{"seq":76,"pid":"A","at":483,"kind":"action","text":"Порыться в бардачке"},{"seq":77,"pid":"A","at":483,"kind":"story","text":"Скребок для стёкол, салфетки, сервисная книжка, бумажная карта области двухлетней давности — и в конверте «на всякий случай» двадцать евро. Ты и забыл про них."},{"seq":78,"pid":"A","at":485,"kind":"action","text":"Поехать на заправку у выезда на трассу"},{"seq":79,"pid":"A","at":495,"kind":"story","text":"— Заправка —"},{"seq":80,"pid":"A","at":495,"kind":"action","text":"Спросить продавца, когда дадут ток"},{"seq":81,"pid":"A","at":495,"kind":"news","text":"Без тока заправки не работают: насосы не качают."},{"seq":82,"pid":"A","at":495,"kind":"news","text":"У Дениза Айдына в мастерской есть канистра бензина, но он не всем продаёт."},{"seq":83,"pid":"A","at":495,"kind":"story","text":"— Да кто ж знает. Говорят, подстанция, к обеду, может. А без тока насосы не качают — бензин в земле, а толку ноль. — Он понижает голос. — Если прям горит — Айдын в промзоне держит канистры. Но он не всем продаёт."},{"seq":84,"pid":"A","at":500,"kind":"action","text":"Взять воды и бутербродов в магазинчике — 6 €"},{"seq":85,"pid":"A","at":503,"kind":"action","text":"Сесть в машину"},{"seq":86,"pid":"A","at":504,"kind":"story","text":"— За рулём —"},{"seq":87,"pid":"A","at":504,"kind":"action","text":"Поехать в мастерскую Айдына в промзоне"},{"seq":88,"pid":"A","at":516,"kind":"story","text":"— Мастерская Айдына —"},{"seq":89,"pid":"A","at":516,"kind":"action","text":"Спросить, что он слышал"},{"seq":90,"pid":"A","at":516,"kind":"news","text":"Брат Дениза, Керем, застрял в Harburg у вокзала. Дениз ждёт его."},{"seq":91,"pid":"A","at":516,"kind":"story","text":"— Брат у меня в Harburg, Керем. Пишет раз в час, когда сеть ловит. Ночью у Phoenix-центра стреляли, полиция. Сказал — выберется ко мне, как сможет. Машину ему вчера разбили. — Дениз вытирает руки. — Жду."},{"seq":92,"pid":"A","at":524,"kind":"action","text":"Спросить, нет ли у него бензина"},{"seq":93,"pid":"A","at":524,"kind":"story","text":"— Бензина — одна канистра, десять литров. Остальное — дизель, тебе он ни к чему: зальёшь — убьёшь мотор. — Он смотрит на тебя оценивающе. — Канистру не продаю. Пока."},{"seq":94,"pid":"A","at":527,"kind":"action","text":"Сказать, что, может, поедешь в Гамбург — через Harburg"},{"seq":95,"pid":"A","at":527,"kind":"story","text":"Дениз впервые смотрит на тебя по-другому. — Через Harburg? Заедешь к Керему? Это у вокзала, Schloßmühlendamm, третий этаж, табличка «Aydın». Он не отвечает с девяти. — Он пишет адрес на обрывке чека. — Я в долгу не останусь."},{"seq":96,"pid":"A","at":530,"kind":"action","text":"Предложить помочь — у него явно полно работы"},{"seq":97,"pid":"A","at":530,"kind":"story","text":"Дениз молча показывает: шины — внутрь, стопками; окно конторы — закрыть стальным листом; ворота — подпереть балкой. Вы работаете почти час, не разговаривая. Потом он протягивает тебе бутылку воды и впервые называет по имени."}],"rng":{"A":0,"B":0},"idSeq":{"A":67,"B":2},"logSeq":{"A":97,"B":1},"history":[]},"last":{"steps":[{"id":"help","label":"Предложить помочь — у него явно полно работы","text":["Дениз молча показывает: шины — внутрь, стопками; окно конторы — закрыть стальным листом; ворота — подпереть балкой. Вы работаете почти час, не разговаривая. Потом он протягивает тебе бутылку воды и впервые называет по имени."],"minutes":50}],"scene":"a_deniz"}}}